# 模型配置（按需修改后另存为 .env，.env 不进 git）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-chat
DEEPSEEK_API_KEY=sk-REPLACE-WITH-YOUR-KEY

# Wayfinder — 可行动的智能行程寻路 Agent
AMAP_API_KEY=REPLACE-WITH-YOUR-AMAP-KEY

# 服务端口（FastAPI）
SERVICE_HOST=127.0.0.1
SERVICE_URL=http://127.0.0.1:8000

# 切换到本地 Ollama 时的写法（注释掉上面三行，启用下面三行）
# DEEPSEEK_BASE_URL=http://127.0.0.1:11434/v1
# DEEPSEEK_DEFAULT_MODEL=qwen2.5:7b
# DEEPSEEK_API_KEY=ollama
